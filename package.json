{
  "name": "paisawise",
  "version": "1.0.0",
  "private": true,
  "description": "Minimalist personal finance management platform.",
  "scripts": {
    "dev": "python run.py",
    "dev:concurrent": "concurrently -n \"backend,frontend\" -c \"gray,white\" \"npm run dev:backend\" \"npm run dev:frontend\"",
    "dev:backend": "cd backend && uvicorn app.main:app --port 8000 --reload",
    "dev:frontend": "cd frontend && npm run dev",
    "start": "python run.py",
    "test": "cd backend && pytest tests/test_api.py",
    "build": "cd frontend && npm run build"
  },
  "license": "MIT",
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
