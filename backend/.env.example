DATABASE_URL="sqlite:///./paisawise.db"
# For PostgreSQL:
# DATABASE_URL="postgresql://paisawise_user:paisawise_password@localhost:5432/paisawise"

# CORS Allowed Origins (Comma separated or JSON array string)
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

